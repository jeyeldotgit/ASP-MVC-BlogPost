@model IEnumerable<BlogPostMVC.Models.Post>

@{
    ViewData["Title"] = "Blog Posts";
}

<h2>Blog Posts</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@post.Id">
                        @post.Title
                    </a>
                </td>
                <td>@post.Author</td>
            </tr>
        }
    </tbody>
</table>
